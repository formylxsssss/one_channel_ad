 101:device/adc_stream.c **** int AdcStream_Start(const AppConfig_t *cfg)
 102:device/adc_stream.c **** {
 103:device/adc_stream.c ****     uint32_t primask;
 104:device/adc_stream.c **** 
 105:device/adc_stream.c ****     if (!AppConfig_IsValid(cfg))
 106:device/adc_stream.c ****     {
 107:device/adc_stream.c ****         return -1;
 108:device/adc_stream.c ****     }
 109:device/adc_stream.c **** 
 110:device/adc_stream.c ****     ADS127L11_Stop();
 111:device/adc_stream.c ****     ADS127L11_StreamExit();
 112:device/adc_stream.c **** 
 113:device/adc_stream.c ****     if (ADS127L11_PrepareContinuousDma(cfg) != 0)
 114:device/adc_stream.c ****     {
 115:device/adc_stream.c ****         return -2;
 116:device/adc_stream.c ****     }
 117:device/adc_stream.c **** 
 118:device/adc_stream.c ****     primask = __get_PRIMASK();
 119:device/adc_stream.c ****     __disable_irq();
 120:device/adc_stream.c ****     clear_state_common();
 121:device/adc_stream.c ****     s_bps = AppConfig_BytesPerSample(cfg);
 122:device/adc_stream.c ****     s_running = 1U;
 123:device/adc_stream.c ****     s_wait_first_drdy = 1U;
 124:device/adc_stream.c ****     s_flags |= APP_STREAM_FLAG_WAIT_FIRST_DRDY;
 125:device/adc_stream.c ****     if (primask == 0U)
 126:device/adc_stream.c ****     {
 127:device/adc_stream.c ****         __enable_irq();
 128:device/adc_stream.c ****     }
 129:device/adc_stream.c **** 
 130:device/adc_stream.c ****     __HAL_GPIO_EXTI_CLEAR_IT(ADS127L11_DRDY_Pin);
 131:device/adc_stream.c ****     HAL_NVIC_EnableIRQ(EXTI3_IRQn);
 132:device/adc_stream.c **** 
 133:device/adc_stream.c ****     /* 先 CS 拉低，然后 START 拉高；第一个 DRDY 下降沿里启动连续 SPI DMA。 */
 134:device/adc_stream.c ****     ADS127L11_StreamEnter();
 135:device/adc_stream.c ****     ADS127L11_Start();
 136:device/adc_stream.c **** 
 137:device/adc_stream.c ****     return 0;
 138:device/adc_stream.c **** }
