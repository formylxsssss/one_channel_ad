 181:device/adc_stream.c **** 
 182:device/adc_stream.c **** void AdcStream_Task(void)
 183:device/adc_stream.c **** {
 184:device/adc_stream.c ****     /*
 185:device/adc_stream.c ****      * 性能版关键点：连续 SPI DMA 的半缓冲解析放在主循环执行，
 186:device/adc_stream.c ****      * DMA IRQ 只置 pending 标志，避免长时间占用中断导致以太网/TCP 来不及处�
 187:device/adc_stream.c ****      */
 188:device/adc_stream.c ****     ADS127L11_PollContinuousDma();
 189:device/adc_stream.c **** 
 190:device/adc_stream.c ****     if (s_stop_request != 0U)
 191:device/adc_stream.c ****     {
 192:device/adc_stream.c ****         s_stop_request = 0;
 193:device/adc_stream.c ****         ADS127L11_Stop();
 194:device/adc_stream.c ****         ADS127L11_StreamExit();
 195:device/adc_stream.c ****         AdcStream_FlushPartialBlock();
 196:device/adc_stream.c ****     }
 197:device/adc_stream.c **** }
