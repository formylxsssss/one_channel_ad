   4:device/range_ctrl.c **** 
   5:device/range_ctrl.c **** /*
   6:device/range_ctrl.c ****  * STM32F427VGT6 + AO6802 增益档位控制
   7:device/range_ctrl.c ****  *
   8:device/range_ctrl.c ****  * 结合当前原理图：
   9:device/range_ctrl.c ****  *   PG11 -> Q5B -> 控制 CH1_D0
  10:device/range_ctrl.c ****  *   PG12 -> Q5A -> 控制 CH1_D1
  11:device/range_ctrl.c ****  *   PG13 -> Q6B -> 控制 CH1_D2
  12:device/range_ctrl.c ****  *   PG14 -> Q6A -> 控制 CH1_D3
  13:device/range_ctrl.c ****  *
  14:device/range_ctrl.c ****  * 原理图逻辑：
  15:device/range_ctrl.c ****  *   MCU PGx = 1：上方 AO6802 导通，把 CH1_Dx 拉到 0V，下面反馈支路关闭
  16:device/range_ctrl.c ****  *   MCU PGx = 0：上方 AO6802 关闭，CH1_Dx 被 5V 上拉，下面反馈支路导通
  17:device/range_ctrl.c ****  *
  18:device/range_ctrl.c ****  * 所以：
  19:device/range_ctrl.c ****  *   MCU GPIO 低电平 = 打开对应增益档
  20:device/range_ctrl.c ****  *   MCU GPIO 高电平 = 关闭对应增益档
  21:device/range_ctrl.c ****  *
  22:device/range_ctrl.c ****  * range 字段继续保留原协议名字，但含义改为增益档：
  23:device/range_ctrl.c ****  *   range = 0 -> 0dB  -> CH1_D0 -> R49/R50
  24:device/range_ctrl.c ****  *   range = 1 -> 20dB -> CH1_D1 -> R51/R52
  25:device/range_ctrl.c ****  *   range = 2 -> 40dB -> CH1_D2 -> R53/R54
  26:device/range_ctrl.c ****  *   range = 3 -> 保留，不使用，始终关闭
  27:device/range_ctrl.c ****  */
  28:device/range_ctrl.c **** 
  29:device/range_ctrl.c **** #ifndef RANGE_ALL_OFF_DELAY_MS
  30:device/range_ctrl.c **** #define RANGE_ALL_OFF_DELAY_MS        5U
ARM GAS  /tmp/ccqQ4Cgr.s 			page 2


  31:device/range_ctrl.c **** #endif
  32:device/range_ctrl.c **** 
  33:device/range_ctrl.c **** #ifndef RANGE_SETTLE_DELAY_MS
  34:device/range_ctrl.c **** #define RANGE_SETTLE_DELAY_MS         50U
  35:device/range_ctrl.c **** #endif
  36:device/range_ctrl.c **** 
