 183:device/ads127l11.c **** /*
 184:device/ads127l11.c ****  * ADS127L11 3-wire frame reset pattern：至少 63 个连续 1 后接 1 个 0。
 185:device/ads127l11.c ****  * 这里发送 64 bit：FF FF FF FF FF FF FF FE。
 186:device/ads127l11.c ****  * 作用：在 CS 始终为低的 3-wire 模式下，把 SPI 串行帧重新对齐。
 187:device/ads127l11.c ****  */
 188:device/ads127l11.c **** static int ads_3wire_frame_reset_pattern(void)
 189:device/ads127l11.c **** {
 190:device/ads127l11.c ****     uint8_t tx[8] = {0xFFU, 0xFFU, 0xFFU, 0xFFU, 0xFFU, 0xFFU, 0xFFU, 0xFEU};
 191:device/ads127l11.c ****     uint8_t rx[8] = {0};
 192:device/ads127l11.c **** 
 193:device/ads127l11.c ****     ads_cs_low();
 194:device/ads127l11.c ****     ads_clear_spi_rx_ovr();
 195:device/ads127l11.c **** 
 196:device/ads127l11.c ****     if (HAL_SPI_TransmitReceive(&hspi4, tx, rx, sizeof(tx), 100) != HAL_OK)
 197:device/ads127l11.c ****     {
 198:device/ads127l11.c ****         s_last_hal_spi_error = HAL_SPI_GetError(&hspi4);
 199:device/ads127l11.c ****         s_last_hal_spi_state = HAL_SPI_GetState(&hspi4);
 200:device/ads127l11.c ****         return -1;
 201:device/ads127l11.c ****     }
 202:device/ads127l11.c **** 
