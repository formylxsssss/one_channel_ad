 111:device/ads127l11.c **** 
 112:device/ads127l11.c **** static uint32_t ads_spi_prescaler_for_cfg(const AppConfig_t *cfg)
 113:device/ads127l11.c **** {
 114:device/ads127l11.c ****     uint32_t required_hz;
 115:device/ads127l11.c ****     uint32_t frame_bits;
 116:device/ads127l11.c ****     uint32_t fs;
 117:device/ads127l11.c **** 
 118:device/ads127l11.c ****     /*
ARM GAS  /tmp/cc4C5Ctn.s 			page 6


 119:device/ads127l11.c ****      * SPI4 在 APB2 上，当前工程 APB2=84MHz。
 120:device/ads127l11.c ****      * 连续 DMA 方案下，SPI 只是高速轮询 ADS127L11 输出帧；
 121:device/ads127l11.c ****      * 真正的新样点必须靠 STATUS.DRDY(bit0) 判断。
 122:device/ads127l11.c ****      *
 123:device/ads127l11.c ****      * 分频选择原则：SCLK 必须 >= fs * 输出帧bit数，且不要太离谱。
 124:device/ads127l11.c ****      * 这样不会读不完当前转换数据，也不会把旧帧误算成采样率。
 125:device/ads127l11.c ****      */
 126:device/ads127l11.c ****     if (cfg == 0)
 127:device/ads127l11.c ****     {
 128:device/ads127l11.c ****         return SPI_BAUDRATEPRESCALER_4;
 129:device/ads127l11.c ****     }
 130:device/ads127l11.c **** 
 131:device/ads127l11.c ****     fs = cfg->fs_hz;
 132:device/ads127l11.c ****     frame_bits = (uint32_t)AppConfig_BytesPerSample(cfg) * 8UL;
 133:device/ads127l11.c **** #if (APP_ADC_CONT_STATUS_ENABLE != 0U)
 134:device/ads127l11.c ****     frame_bits += 8UL;
 135:device/ads127l11.c **** #endif
 136:device/ads127l11.c ****     required_hz = fs * frame_bits;
 137:device/ads127l11.c **** 
 138:device/ads127l11.c ****     if (required_hz > 10500000UL) { return SPI_BAUDRATEPRESCALER_4;   } /* 21.000MHz */
 139:device/ads127l11.c ****     if (required_hz >  5250000UL) { return SPI_BAUDRATEPRESCALER_8;   } /* 10.500MHz */
 140:device/ads127l11.c ****     if (required_hz >  2625000UL) { return SPI_BAUDRATEPRESCALER_16;  } /* 5.250MHz */
 141:device/ads127l11.c ****     if (required_hz >  1312500UL) { return SPI_BAUDRATEPRESCALER_32;  } /* 2.625MHz */
 142:device/ads127l11.c ****     if (required_hz >   656250UL) { return SPI_BAUDRATEPRESCALER_64;  } /* 1.3125MHz */
 143:device/ads127l11.c ****     if (required_hz >   328125UL) { return SPI_BAUDRATEPRESCALER_128; } /* 0.65625MHz */
 144:device/ads127l11.c ****     return SPI_BAUDRATEPRESCALER_256;                                  /* 0.328125MHz */
 145:device/ads127l11.c **** }
