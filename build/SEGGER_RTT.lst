 259:ARM_SEGGER_RTT/SEGGER_RTT.c **** /*********************************************************************
 260:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 261:ARM_SEGGER_RTT/SEGGER_RTT.c **** *       _DoInit()
 262:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 263:ARM_SEGGER_RTT/SEGGER_RTT.c **** *  Function description
 264:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    Initializes the control block an buffers.
 265:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    May only be called via INIT() to avoid overriding settings.
 266:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 267:ARM_SEGGER_RTT/SEGGER_RTT.c **** */
 268:ARM_SEGGER_RTT/SEGGER_RTT.c **** #define INIT()  do {                                            \
 269:ARM_SEGGER_RTT/SEGGER_RTT.c ****                   if (_SEGGER_RTT.acID[0] == '\0') { _DoInit(); }  \
 270:ARM_SEGGER_RTT/SEGGER_RTT.c ****                 } while (0)
 271:ARM_SEGGER_RTT/SEGGER_RTT.c **** static void _DoInit(void) {
 272:ARM_SEGGER_RTT/SEGGER_RTT.c ****   SEGGER_RTT_CB* p;
 273:ARM_SEGGER_RTT/SEGGER_RTT.c ****   //
 274:ARM_SEGGER_RTT/SEGGER_RTT.c ****   // Initialize control block
 275:ARM_SEGGER_RTT/SEGGER_RTT.c ****   //
 276:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p = &_SEGGER_RTT;
 277:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->MaxNumUpBuffers    = SEGGER_RTT_MAX_NUM_UP_BUFFERS;
 278:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->MaxNumDownBuffers  = SEGGER_RTT_MAX_NUM_DOWN_BUFFERS;
 279:ARM_SEGGER_RTT/SEGGER_RTT.c ****   //
 280:ARM_SEGGER_RTT/SEGGER_RTT.c ****   // Initialize up buffer 0
 281:ARM_SEGGER_RTT/SEGGER_RTT.c ****   //
 282:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->aUp[0].sName         = "Terminal";
 283:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->aUp[0].pBuffer       = _acUpBuffer;
 284:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->aUp[0].SizeOfBuffer  = sizeof(_acUpBuffer);
 285:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->aUp[0].RdOff         = 0u;
 286:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->aUp[0].WrOff         = 0u;
 287:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->aUp[0].Flags         = SEGGER_RTT_MODE_DEFAULT;
 288:ARM_SEGGER_RTT/SEGGER_RTT.c ****   //
 289:ARM_SEGGER_RTT/SEGGER_RTT.c ****   // Initialize down buffer 0
 290:ARM_SEGGER_RTT/SEGGER_RTT.c ****   //
 291:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->aDown[0].sName         = "Terminal";
 292:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->aDown[0].pBuffer       = _acDownBuffer;
 293:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->aDown[0].SizeOfBuffer  = sizeof(_acDownBuffer);
 294:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->aDown[0].RdOff         = 0u;
 295:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->aDown[0].WrOff         = 0u;
 296:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->aDown[0].Flags         = SEGGER_RTT_MODE_DEFAULT;
 297:ARM_SEGGER_RTT/SEGGER_RTT.c ****   //
 298:ARM_SEGGER_RTT/SEGGER_RTT.c ****   // Finish initialization of the control block.
 299:ARM_SEGGER_RTT/SEGGER_RTT.c ****   // Copy Id string in three steps to make sure "SEGGER RTT" is not found
 300:ARM_SEGGER_RTT/SEGGER_RTT.c ****   // in initializer memory (usually flash) by J-Link
 301:ARM_SEGGER_RTT/SEGGER_RTT.c ****   //
 302:ARM_SEGGER_RTT/SEGGER_RTT.c ****   strcpy(&p->acID[7], "RTT");
 303:ARM_SEGGER_RTT/SEGGER_RTT.c ****   strcpy(&p->acID[0], "SEGGER");
 304:ARM_SEGGER_RTT/SEGGER_RTT.c ****   p->acID[6] = ' ';
 305:ARM_SEGGER_RTT/SEGGER_RTT.c **** }
 306:ARM_SEGGER_RTT/SEGGER_RTT.c **** 
 307:ARM_SEGGER_RTT/SEGGER_RTT.c **** /*********************************************************************
 308:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 309:ARM_SEGGER_RTT/SEGGER_RTT.c **** *       _WriteBlocking()
 310:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 311:ARM_SEGGER_RTT/SEGGER_RTT.c **** *  Function description
 312:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    Stores a specified number of characters in SEGGER RTT ring buffer
 313:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    and updates the associated write pointer which is periodically
 314:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    read by the host.
 315:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    The caller is responsible for managing the write chunk sizes as
ARM GAS  /tmp/ccRQNo80.s 			page 7


 316:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    _WriteBlocking() will block until all data has been posted successfully.
 317:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 318:ARM_SEGGER_RTT/SEGGER_RTT.c **** *  Parameters
 319:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    pRing        Ring buffer to post to.
 320:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    pBuffer      Pointer to character array. Does not need to point to a \0 terminated string.
 321:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    NumBytes     Number of bytes to be stored in the SEGGER RTT control block.
 322:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 323:ARM_SEGGER_RTT/SEGGER_RTT.c **** *  Return value
 324:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    >= 0 - Number of bytes written into buffer.
 325:ARM_SEGGER_RTT/SEGGER_RTT.c **** */
 326:ARM_SEGGER_RTT/SEGGER_RTT.c **** static unsigned _WriteBlocking(SEGGER_RTT_BUFFER_UP* pRing, const char* pBuffer, unsigned NumBytes)
 327:ARM_SEGGER_RTT/SEGGER_RTT.c ****   unsigned NumBytesToWrite;
 328:ARM_SEGGER_RTT/SEGGER_RTT.c ****   unsigned NumBytesWritten;
 329:ARM_SEGGER_RTT/SEGGER_RTT.c ****   unsigned RdOff;
 330:ARM_SEGGER_RTT/SEGGER_RTT.c ****   unsigned WrOff;
 331:ARM_SEGGER_RTT/SEGGER_RTT.c ****   //
 332:ARM_SEGGER_RTT/SEGGER_RTT.c ****   // Write data to buffer and handle wrap-around if necessary
 333:ARM_SEGGER_RTT/SEGGER_RTT.c ****   //
 334:ARM_SEGGER_RTT/SEGGER_RTT.c ****   NumBytesWritten = 0u;
 335:ARM_SEGGER_RTT/SEGGER_RTT.c ****   WrOff = pRing->WrOff;
 336:ARM_SEGGER_RTT/SEGGER_RTT.c ****   do {
 337:ARM_SEGGER_RTT/SEGGER_RTT.c ****     RdOff = pRing->RdOff;                         // May be changed by host (debug probe) in the me
 338:ARM_SEGGER_RTT/SEGGER_RTT.c ****     if (RdOff > WrOff) {
 339:ARM_SEGGER_RTT/SEGGER_RTT.c ****       NumBytesToWrite = RdOff - WrOff - 1u;
 340:ARM_SEGGER_RTT/SEGGER_RTT.c ****     } else {
 341:ARM_SEGGER_RTT/SEGGER_RTT.c ****       NumBytesToWrite = pRing->SizeOfBuffer - (WrOff - RdOff + 1u);
 342:ARM_SEGGER_RTT/SEGGER_RTT.c ****     }
 343:ARM_SEGGER_RTT/SEGGER_RTT.c ****     NumBytesToWrite = MIN(NumBytesToWrite, (pRing->SizeOfBuffer - WrOff));      // Number of bytes 
 344:ARM_SEGGER_RTT/SEGGER_RTT.c ****     NumBytesToWrite = MIN(NumBytesToWrite, NumBytes);
 345:ARM_SEGGER_RTT/SEGGER_RTT.c ****     memcpy(pRing->pBuffer + WrOff, pBuffer, NumBytesToWrite);
 346:ARM_SEGGER_RTT/SEGGER_RTT.c ****     NumBytesWritten += NumBytesToWrite;
 347:ARM_SEGGER_RTT/SEGGER_RTT.c ****     pBuffer         += NumBytesToWrite;
 348:ARM_SEGGER_RTT/SEGGER_RTT.c ****     NumBytes        -= NumBytesToWrite;
 349:ARM_SEGGER_RTT/SEGGER_RTT.c ****     WrOff           += NumBytesToWrite;
 350:ARM_SEGGER_RTT/SEGGER_RTT.c ****     if (WrOff == pRing->SizeOfBuffer) {
 351:ARM_SEGGER_RTT/SEGGER_RTT.c ****       WrOff = 0u;
 352:ARM_SEGGER_RTT/SEGGER_RTT.c ****     }
 353:ARM_SEGGER_RTT/SEGGER_RTT.c ****     pRing->WrOff = WrOff;
 354:ARM_SEGGER_RTT/SEGGER_RTT.c ****   } while (NumBytes);
 355:ARM_SEGGER_RTT/SEGGER_RTT.c ****   //
 356:ARM_SEGGER_RTT/SEGGER_RTT.c ****   return NumBytesWritten;
 357:ARM_SEGGER_RTT/SEGGER_RTT.c **** }
 358:ARM_SEGGER_RTT/SEGGER_RTT.c **** 
 359:ARM_SEGGER_RTT/SEGGER_RTT.c **** /*********************************************************************
 360:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 361:ARM_SEGGER_RTT/SEGGER_RTT.c **** *       _WriteNoCheck()
 362:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 363:ARM_SEGGER_RTT/SEGGER_RTT.c **** *  Function description
 364:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    Stores a specified number of characters in SEGGER RTT ring buffer
 365:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    and updates the associated write pointer which is periodically
 366:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    read by the host.
 367:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    It is callers responsibility to make sure data actually fits in buffer.
 368:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 369:ARM_SEGGER_RTT/SEGGER_RTT.c **** *  Parameters
 370:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    pRing        Ring buffer to post to.
 371:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    pBuffer      Pointer to character array. Does not need to point to a \0 terminated string.
 372:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    NumBytes     Number of bytes to be stored in the SEGGER RTT control block.
ARM GAS  /tmp/ccRQNo80.s 			page 8


 373:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 374:ARM_SEGGER_RTT/SEGGER_RTT.c **** *  Notes
 375:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    (1) If there might not be enough space in the "Up"-buffer, call _WriteBlocking
 376:ARM_SEGGER_RTT/SEGGER_RTT.c **** */
 377:ARM_SEGGER_RTT/SEGGER_RTT.c **** static void _WriteNoCheck(SEGGER_RTT_BUFFER_UP* pRing, const char* pData, unsigned NumBytes) {
 378:ARM_SEGGER_RTT/SEGGER_RTT.c ****   unsigned NumBytesAtOnce;
 379:ARM_SEGGER_RTT/SEGGER_RTT.c ****   unsigned WrOff;
 380:ARM_SEGGER_RTT/SEGGER_RTT.c ****   unsigned Rem;
 381:ARM_SEGGER_RTT/SEGGER_RTT.c **** 
 382:ARM_SEGGER_RTT/SEGGER_RTT.c ****   WrOff = pRing->WrOff;
 383:ARM_SEGGER_RTT/SEGGER_RTT.c ****   Rem = pRing->SizeOfBuffer - WrOff;
 384:ARM_SEGGER_RTT/SEGGER_RTT.c ****   if (Rem > NumBytes) {
 385:ARM_SEGGER_RTT/SEGGER_RTT.c ****     //
 386:ARM_SEGGER_RTT/SEGGER_RTT.c ****     // All data fits before wrap around
 387:ARM_SEGGER_RTT/SEGGER_RTT.c ****     //
 388:ARM_SEGGER_RTT/SEGGER_RTT.c ****     memcpy(pRing->pBuffer + WrOff, pData, NumBytes);
 389:ARM_SEGGER_RTT/SEGGER_RTT.c ****     pRing->WrOff = WrOff + NumBytes;
 390:ARM_SEGGER_RTT/SEGGER_RTT.c ****   } else {
 391:ARM_SEGGER_RTT/SEGGER_RTT.c ****     //
 392:ARM_SEGGER_RTT/SEGGER_RTT.c ****     // We reach the end of the buffer, so need to wrap around
 393:ARM_SEGGER_RTT/SEGGER_RTT.c ****     //
 394:ARM_SEGGER_RTT/SEGGER_RTT.c ****     NumBytesAtOnce = Rem;
 395:ARM_SEGGER_RTT/SEGGER_RTT.c ****     memcpy(pRing->pBuffer + WrOff, pData, NumBytesAtOnce);
 396:ARM_SEGGER_RTT/SEGGER_RTT.c ****     NumBytesAtOnce = NumBytes - Rem;
 397:ARM_SEGGER_RTT/SEGGER_RTT.c ****     memcpy(pRing->pBuffer, pData + Rem, NumBytesAtOnce);
 398:ARM_SEGGER_RTT/SEGGER_RTT.c ****     pRing->WrOff = NumBytesAtOnce;
 399:ARM_SEGGER_RTT/SEGGER_RTT.c ****   }
 400:ARM_SEGGER_RTT/SEGGER_RTT.c **** }
 401:ARM_SEGGER_RTT/SEGGER_RTT.c **** 
 402:ARM_SEGGER_RTT/SEGGER_RTT.c **** /*********************************************************************
 403:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 404:ARM_SEGGER_RTT/SEGGER_RTT.c **** *       _PostTerminalSwitch()
 405:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 406:ARM_SEGGER_RTT/SEGGER_RTT.c **** *  Function description
 407:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    Switch terminal to the given terminal ID.  It is the caller's
 408:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    responsibility to ensure the terminal ID is correct and there is
 409:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    enough space in the buffer for this to complete successfully.
 410:ARM_SEGGER_RTT/SEGGER_RTT.c **** *
 411:ARM_SEGGER_RTT/SEGGER_RTT.c **** *  Parameters
 412:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    pRing        Ring buffer to post to.
 413:ARM_SEGGER_RTT/SEGGER_RTT.c **** *    TerminalId   Terminal ID to switch to.
 414:ARM_SEGGER_RTT/SEGGER_RTT.c **** */
 415:ARM_SEGGER_RTT/SEGGER_RTT.c **** static void _PostTerminalSwitch(SEGGER_RTT_BUFFER_UP* pRing, unsigned char TerminalId) {
 416:ARM_SEGGER_RTT/SEGGER_RTT.c ****   char ac[2];
 417:ARM_SEGGER_RTT/SEGGER_RTT.c **** 
 418:ARM_SEGGER_RTT/SEGGER_RTT.c ****   ac[0] = 0xFFu;
 419:ARM_SEGGER_RTT/SEGGER_RTT.c ****   ac[1] = _aTerminalId[TerminalId];  // Caller made already sure that TerminalId does not exceed ou
 420:ARM_SEGGER_RTT/SEGGER_RTT.c ****   _WriteBlocking(pRing, ac, 2u);
 421:ARM_SEGGER_RTT/SEGGER_RTT.c **** }
