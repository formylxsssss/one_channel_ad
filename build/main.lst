 253:Core/Src/main.c **** static uint32_t ETH_Get_MDIO_CR(void)
 254:Core/Src/main.c **** {
 255:Core/Src/main.c ****   uint32_t hclk = HAL_RCC_GetHCLKFreq();
 256:Core/Src/main.c **** 
 257:Core/Src/main.c ****   /*
 258:Core/Src/main.c ****    * 当前 HCLK=168MHz，Div102 后 MDC 约 1.65MHz。
 259:Core/Src/main.c ****    */
 260:Core/Src/main.c ****   if (hclk >= 150000000U)
 261:Core/Src/main.c ****   {
 262:Core/Src/main.c ****     return ETH_MACMIIAR_CR_Div102;
 263:Core/Src/main.c ****   }
 264:Core/Src/main.c ****   else if (hclk >= 100000000U)
 265:Core/Src/main.c ****   {
 266:Core/Src/main.c ****     return ETH_MACMIIAR_CR_Div62;
 267:Core/Src/main.c ****   }
 268:Core/Src/main.c ****   else if (hclk >= 60000000U)
 269:Core/Src/main.c ****   {
 270:Core/Src/main.c ****     return ETH_MACMIIAR_CR_Div42;
 271:Core/Src/main.c ****   }
 272:Core/Src/main.c ****   else if (hclk >= 35000000U)
 273:Core/Src/main.c ****   {
 274:Core/Src/main.c ****     return ETH_MACMIIAR_CR_Div26;
 275:Core/Src/main.c ****   }
 276:Core/Src/main.c ****   else
 277:Core/Src/main.c ****   {
 278:Core/Src/main.c ****     return ETH_MACMIIAR_CR_Div16;
 279:Core/Src/main.c ****   }
 280:Core/Src/main.c **** }
