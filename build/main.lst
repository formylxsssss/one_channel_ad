 281:Core/Src/main.c **** 
 282:Core/Src/main.c **** static HAL_StatusTypeDef ETH_MDIO_Read(uint8_t phy_addr, uint8_t reg, uint16_t *value)
 283:Core/Src/main.c **** {
 284:Core/Src/main.c ****   uint32_t tickstart;
 285:Core/Src/main.c ****   uint32_t mdio_cr;
 286:Core/Src/main.c **** 
 287:Core/Src/main.c ****   if (value == NULL)
 288:Core/Src/main.c ****   {
 289:Core/Src/main.c ****     return HAL_ERROR;
 290:Core/Src/main.c ****   }
 291:Core/Src/main.c **** 
 292:Core/Src/main.c ****   mdio_cr = ETH_Get_MDIO_CR();
 293:Core/Src/main.c **** 
 294:Core/Src/main.c ****   tickstart = HAL_GetTick();
 295:Core/Src/main.c ****   while ((ETH->MACMIIAR & ETH_MACMIIAR_MB) != 0U)
 296:Core/Src/main.c ****   {
 297:Core/Src/main.c ****     if ((HAL_GetTick() - tickstart) > ETH_MDIO_TIMEOUT_MS)
 298:Core/Src/main.c ****     {
 299:Core/Src/main.c ****       return HAL_TIMEOUT;
 300:Core/Src/main.c ****     }
 301:Core/Src/main.c ****   }
 302:Core/Src/main.c **** 
 303:Core/Src/main.c ****   /*
 304:Core/Src/main.c ****    * MW bit = 0，read。
 305:Core/Src/main.c ****    */
 306:Core/Src/main.c ****   ETH->MACMIIAR =
 307:Core/Src/main.c ****       ((((uint32_t)phy_addr) << ETH_MACMIIAR_PA_SHIFT) & ETH_MACMIIAR_PA_MASK) |
 308:Core/Src/main.c ****       ((((uint32_t)reg)      << ETH_MACMIIAR_MR_SHIFT) & ETH_MACMIIAR_MR_MASK) |
 309:Core/Src/main.c ****       mdio_cr |
 310:Core/Src/main.c ****       ETH_MACMIIAR_MB;
 311:Core/Src/main.c **** 
 312:Core/Src/main.c ****   tickstart = HAL_GetTick();
 313:Core/Src/main.c ****   while ((ETH->MACMIIAR & ETH_MACMIIAR_MB) != 0U)
 314:Core/Src/main.c ****   {
 315:Core/Src/main.c ****     if ((HAL_GetTick() - tickstart) > ETH_MDIO_TIMEOUT_MS)
 316:Core/Src/main.c ****     {
 317:Core/Src/main.c ****       return HAL_TIMEOUT;
 318:Core/Src/main.c ****     }
 319:Core/Src/main.c ****   }
 320:Core/Src/main.c **** 
 321:Core/Src/main.c ****   *value = (uint16_t)(ETH->MACMIIDR & 0xFFFFU);
 322:Core/Src/main.c ****   return HAL_OK;
 323:Core/Src/main.c **** }
