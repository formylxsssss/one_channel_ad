 348:Core/Src/main.c **** static uint32_t LAN8720_ReadInfo(EthPhyInfo_t *info)
 349:Core/Src/main.c **** {
 350:Core/Src/main.c ****   uint8_t addr;
 351:Core/Src/main.c ****   uint16_t id1;
 352:Core/Src/main.c ****   uint16_t id2;
