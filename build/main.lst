 414:Core/Src/main.c **** static uint32_t LAN8720_BootSelfTest(uint32_t wait_ms)
 415:Core/Src/main.c **** {
 416:Core/Src/main.c ****   EthPhyInfo_t info;
 417:Core/Src/main.c ****   uint32_t start_tick;
 418:Core/Src/main.c **** 
