 354:Core/Src/main.c ****   HAL_StatusTypeDef r2;
 355:Core/Src/main.c **** 
 356:Core/Src/main.c ****   if (info == NULL)
 357:Core/Src/main.c ****   {
 358:Core/Src/main.c ****     return 1U;
 359:Core/Src/main.c ****   }
 360:Core/Src/main.c **** 
ARM GAS  C:\msys64\tmp\ccLLe0oR.s 			page 13


 361:Core/Src/main.c ****   memset(info, 0, sizeof(*info));
 362:Core/Src/main.c **** 
 363:Core/Src/main.c ****   for (addr = 0U; addr < 32U; addr++)
 364:Core/Src/main.c ****   {
 365:Core/Src/main.c ****     id1 = 0U;
 366:Core/Src/main.c ****     id2 = 0U;
 367:Core/Src/main.c **** 
 368:Core/Src/main.c ****     r1 = ETH_MDIO_Read(addr, LAN8720_REG_PHYID1, &id1);
 369:Core/Src/main.c ****     r2 = ETH_MDIO_Read(addr, LAN8720_REG_PHYID2, &id2);
 370:Core/Src/main.c **** 
 371:Core/Src/main.c ****     if ((r1 != HAL_OK) || (r2 != HAL_OK))
 372:Core/Src/main.c ****     {
 373:Core/Src/main.c ****       continue;
 374:Core/Src/main.c ****     }
 375:Core/Src/main.c **** 
 376:Core/Src/main.c ****     if (((id1 == 0x0000U) && (id2 == 0x0000U)) ||
 377:Core/Src/main.c ****         ((id1 == 0xFFFFU) && (id2 == 0xFFFFU)))
 378:Core/Src/main.c ****     {
 379:Core/Src/main.c ****       continue;
 380:Core/Src/main.c ****     }
 381:Core/Src/main.c **** 
 382:Core/Src/main.c ****     if ((id1 == LAN8720_ID1_EXPECTED) &&
 383:Core/Src/main.c ****         ((id2 & LAN8720_ID2_MASK) == LAN8720_ID2_EXPECTED_MASKED))
 384:Core/Src/main.c ****     {
 385:Core/Src/main.c ****       info->found = 1U;
 386:Core/Src/main.c ****       info->phy_addr = addr;
 387:Core/Src/main.c ****       info->id1 = id1;
 388:Core/Src/main.c ****       info->id2 = id2;
 389:Core/Src/main.c **** 
 390:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_BCR,     &info->bcr);
 391:Core/Src/main.c **** 
 392:Core/Src/main.c ****       /*
 393:Core/Src/main.c ****        * BSR Link Status 是 latch-low，连续读两次。
 394:Core/Src/main.c ****        */
 395:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_BSR,     &info->bsr1);
 396:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_BSR,     &info->bsr2);
 397:Core/Src/main.c **** 
 398:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_ANAR,    &info->anar);
 399:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_ANLPAR,  &info->anlpar);
 400:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_ANER,    &info->aner);
 401:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_SPECIAL, &info->special);
 402:Core/Src/main.c **** 
 403:Core/Src/main.c ****       return 0U;
 404:Core/Src/main.c ****     }
 405:Core/Src/main.c ****   }
 406:Core/Src/main.c **** 
 407:Core/Src/main.c ****   return 2U;
 408:Core/Src/main.c **** }
