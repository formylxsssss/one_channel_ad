 439:Core/Src/main.c **** 
 440:Core/Src/main.c ****   if (LAN8720_ReadInfo(&info) == 0U)
 441:Core/Src/main.c ****   {
 442:Core/Src/main.c ****     LOG_ERR("LAN8720A selftest: PHY found but link not ready, addr=%u, BSR=0x%04X, SPECIAL=0x%04X, 
 443:Core/Src/main.c ****             info.phy_addr,
 444:Core/Src/main.c ****             info.bsr2,
 445:Core/Src/main.c ****             info.special,
