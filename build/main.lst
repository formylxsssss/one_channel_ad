 257:Core/Src/main.c **** static uint32_t ETH_Get_MDIO_CR(void)
 258:Core/Src/main.c **** {
 259:Core/Src/main.c ****   uint32_t hclk = HAL_RCC_GetHCLKFreq();
 260:Core/Src/main.c **** 
 261:Core/Src/main.c ****   /*
 262:Core/Src/main.c ****    * 当前 HCLK=168MHz，Div102 后 MDC 约 1.65MHz。
 263:Core/Src/main.c ****    */
 264:Core/Src/main.c ****   if (hclk >= 150000000U)
 265:Core/Src/main.c ****   {
 266:Core/Src/main.c ****     return ETH_MACMIIAR_CR_Div102;
 267:Core/Src/main.c ****   }
 268:Core/Src/main.c ****   else if (hclk >= 100000000U)
 269:Core/Src/main.c ****   {
 270:Core/Src/main.c ****     return ETH_MACMIIAR_CR_Div62;
 271:Core/Src/main.c ****   }
 272:Core/Src/main.c ****   else if (hclk >= 60000000U)
 273:Core/Src/main.c ****   {
 274:Core/Src/main.c ****     return ETH_MACMIIAR_CR_Div42;
 275:Core/Src/main.c ****   }
 276:Core/Src/main.c ****   else if (hclk >= 35000000U)
 277:Core/Src/main.c ****   {
 278:Core/Src/main.c ****     return ETH_MACMIIAR_CR_Div26;
 279:Core/Src/main.c ****   }
 280:Core/Src/main.c ****   else
ARM GAS  /tmp/ccxFolJG.s 			page 10


 281:Core/Src/main.c ****   {
 282:Core/Src/main.c ****     return ETH_MACMIIAR_CR_Div16;
 283:Core/Src/main.c ****   }
 284:Core/Src/main.c **** }
 285:Core/Src/main.c **** 
 286:Core/Src/main.c **** static HAL_StatusTypeDef ETH_MDIO_Read(uint8_t phy_addr, uint8_t reg, uint16_t *value)
 287:Core/Src/main.c **** {
 288:Core/Src/main.c ****   uint32_t tickstart;
 289:Core/Src/main.c ****   uint32_t mdio_cr;
 290:Core/Src/main.c **** 
 291:Core/Src/main.c ****   if (value == NULL)
 292:Core/Src/main.c ****   {
 293:Core/Src/main.c ****     return HAL_ERROR;
 294:Core/Src/main.c ****   }
 295:Core/Src/main.c **** 
 296:Core/Src/main.c ****   mdio_cr = ETH_Get_MDIO_CR();
 297:Core/Src/main.c **** 
 298:Core/Src/main.c ****   tickstart = HAL_GetTick();
 299:Core/Src/main.c ****   while ((ETH->MACMIIAR & ETH_MACMIIAR_MB) != 0U)
 300:Core/Src/main.c ****   {
 301:Core/Src/main.c ****     if ((HAL_GetTick() - tickstart) > ETH_MDIO_TIMEOUT_MS)
 302:Core/Src/main.c ****     {
 303:Core/Src/main.c ****       return HAL_TIMEOUT;
 304:Core/Src/main.c ****     }
 305:Core/Src/main.c ****   }
 306:Core/Src/main.c **** 
 307:Core/Src/main.c ****   /*
 308:Core/Src/main.c ****    * MW bit = 0，read。
 309:Core/Src/main.c ****    */
 310:Core/Src/main.c ****   ETH->MACMIIAR =
 311:Core/Src/main.c ****       ((((uint32_t)phy_addr) << ETH_MACMIIAR_PA_SHIFT) & ETH_MACMIIAR_PA_MASK) |
 312:Core/Src/main.c ****       ((((uint32_t)reg)      << ETH_MACMIIAR_MR_SHIFT) & ETH_MACMIIAR_MR_MASK) |
 313:Core/Src/main.c ****       mdio_cr |
 314:Core/Src/main.c ****       ETH_MACMIIAR_MB;
 315:Core/Src/main.c **** 
 316:Core/Src/main.c ****   tickstart = HAL_GetTick();
 317:Core/Src/main.c ****   while ((ETH->MACMIIAR & ETH_MACMIIAR_MB) != 0U)
 318:Core/Src/main.c ****   {
 319:Core/Src/main.c ****     if ((HAL_GetTick() - tickstart) > ETH_MDIO_TIMEOUT_MS)
 320:Core/Src/main.c ****     {
 321:Core/Src/main.c ****       return HAL_TIMEOUT;
 322:Core/Src/main.c ****     }
 323:Core/Src/main.c ****   }
 324:Core/Src/main.c **** 
 325:Core/Src/main.c ****   *value = (uint16_t)(ETH->MACMIIDR & 0xFFFFU);
 326:Core/Src/main.c ****   return HAL_OK;
 327:Core/Src/main.c **** }
