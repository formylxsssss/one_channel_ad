 352:Core/Src/main.c **** static uint32_t LAN8720_ReadInfo(EthPhyInfo_t *info)
 353:Core/Src/main.c **** {
 354:Core/Src/main.c ****   uint8_t addr;
 355:Core/Src/main.c ****   uint16_t id1;
 356:Core/Src/main.c ****   uint16_t id2;
 357:Core/Src/main.c ****   HAL_StatusTypeDef r1;
 358:Core/Src/main.c ****   HAL_StatusTypeDef r2;
 359:Core/Src/main.c **** 
 360:Core/Src/main.c ****   if (info == NULL)
 361:Core/Src/main.c ****   {
 362:Core/Src/main.c ****     return 1U;
 363:Core/Src/main.c ****   }
 364:Core/Src/main.c **** 
 365:Core/Src/main.c ****   memset(info, 0, sizeof(*info));
 366:Core/Src/main.c **** 
 367:Core/Src/main.c ****   for (addr = 0U; addr < 32U; addr++)
 368:Core/Src/main.c ****   {
 369:Core/Src/main.c ****     id1 = 0U;
 370:Core/Src/main.c ****     id2 = 0U;
 371:Core/Src/main.c **** 
 372:Core/Src/main.c ****     r1 = ETH_MDIO_Read(addr, LAN8720_REG_PHYID1, &id1);
 373:Core/Src/main.c ****     r2 = ETH_MDIO_Read(addr, LAN8720_REG_PHYID2, &id2);
 374:Core/Src/main.c **** 
 375:Core/Src/main.c ****     if ((r1 != HAL_OK) || (r2 != HAL_OK))
 376:Core/Src/main.c ****     {
 377:Core/Src/main.c ****       continue;
 378:Core/Src/main.c ****     }
 379:Core/Src/main.c **** 
 380:Core/Src/main.c ****     if (((id1 == 0x0000U) && (id2 == 0x0000U)) ||
 381:Core/Src/main.c ****         ((id1 == 0xFFFFU) && (id2 == 0xFFFFU)))
 382:Core/Src/main.c ****     {
 383:Core/Src/main.c ****       continue;
 384:Core/Src/main.c ****     }
 385:Core/Src/main.c **** 
 386:Core/Src/main.c ****     if ((id1 == LAN8720_ID1_EXPECTED) &&
 387:Core/Src/main.c ****         ((id2 & LAN8720_ID2_MASK) == LAN8720_ID2_EXPECTED_MASKED))
 388:Core/Src/main.c ****     {
 389:Core/Src/main.c ****       info->found = 1U;
 390:Core/Src/main.c ****       info->phy_addr = addr;
 391:Core/Src/main.c ****       info->id1 = id1;
 392:Core/Src/main.c ****       info->id2 = id2;
 393:Core/Src/main.c **** 
 394:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_BCR,     &info->bcr);
 395:Core/Src/main.c **** 
ARM GAS  /tmp/ccxFolJG.s 			page 14


 396:Core/Src/main.c ****       /*
 397:Core/Src/main.c ****        * BSR Link Status 是 latch-low，连续读两次。
 398:Core/Src/main.c ****        */
 399:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_BSR,     &info->bsr1);
 400:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_BSR,     &info->bsr2);
 401:Core/Src/main.c **** 
 402:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_ANAR,    &info->anar);
 403:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_ANLPAR,  &info->anlpar);
 404:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_ANER,    &info->aner);
 405:Core/Src/main.c ****       (void)ETH_MDIO_Read(addr, LAN8720_REG_SPECIAL, &info->special);
 406:Core/Src/main.c **** 
 407:Core/Src/main.c ****       return 0U;
 408:Core/Src/main.c ****     }
 409:Core/Src/main.c ****   }
 410:Core/Src/main.c **** 
 411:Core/Src/main.c ****   return 2U;
 412:Core/Src/main.c **** }
