 289:LWIP/Target/ethernetif.c **** /**
 290:LWIP/Target/ethernetif.c ****  * @brief This function should be called when a packet is ready to be read
 291:LWIP/Target/ethernetif.c ****  * from the interface. It uses the function low_level_input() that
 292:LWIP/Target/ethernetif.c ****  * should handle the actual reception of bytes from the network
 293:LWIP/Target/ethernetif.c ****  * interface. Then the type of the received packet is determined and
 294:LWIP/Target/ethernetif.c ****  * the appropriate input function is called.
 295:LWIP/Target/ethernetif.c ****  *
 296:LWIP/Target/ethernetif.c ****  * @param netif the lwip network interface structure for this ethernetif
 297:LWIP/Target/ethernetif.c ****  */
 298:LWIP/Target/ethernetif.c **** void ethernetif_input(struct netif *netif)
 299:LWIP/Target/ethernetif.c **** {
 300:LWIP/Target/ethernetif.c ****   struct pbuf *p = NULL;
 301:LWIP/Target/ethernetif.c **** 
 302:LWIP/Target/ethernetif.c ****   do
 303:LWIP/Target/ethernetif.c ****   {
 304:LWIP/Target/ethernetif.c ****     p = low_level_input( netif );
 305:LWIP/Target/ethernetif.c ****     if (p != NULL)
 306:LWIP/Target/ethernetif.c ****     {
 307:LWIP/Target/ethernetif.c ****       if (netif->input( p, netif) != ERR_OK )
 308:LWIP/Target/ethernetif.c ****       {
 309:LWIP/Target/ethernetif.c ****         pbuf_free(p);
 310:LWIP/Target/ethernetif.c ****       }
 311:LWIP/Target/ethernetif.c ****     }
 312:LWIP/Target/ethernetif.c ****   } while(p!=NULL);
 313:LWIP/Target/ethernetif.c **** }
 314:LWIP/Target/ethernetif.c **** 
