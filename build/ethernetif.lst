 211:LWIP/Target/ethernetif.c **** /**
 212:LWIP/Target/ethernetif.c ****  * @brief This function should do the actual transmission of the packet. The packet is
 213:LWIP/Target/ethernetif.c ****  * contained in the pbuf that is passed to the function. This pbuf
 214:LWIP/Target/ethernetif.c ****  * might be chained.
 215:LWIP/Target/ethernetif.c ****  *
 216:LWIP/Target/ethernetif.c ****  * @param netif the lwip network interface structure for this ethernetif
 217:LWIP/Target/ethernetif.c ****  * @param p the MAC packet to send (e.g. IP packet including MAC addresses and type)
 218:LWIP/Target/ethernetif.c ****  * @return ERR_OK if the packet could be sent
 219:LWIP/Target/ethernetif.c ****  *         an err_t value if the packet couldn't be sent
 220:LWIP/Target/ethernetif.c ****  *
 221:LWIP/Target/ethernetif.c ****  * @note Returning ERR_MEM here if a DMA queue of your MAC is full can lead to
 222:LWIP/Target/ethernetif.c ****  *       strange results. You might consider waiting for space in the DMA queue
 223:LWIP/Target/ethernetif.c ****  *       to become available since the stack doesn't retry to send a packet
 224:LWIP/Target/ethernetif.c ****  *       dropped because of memory failure (except for the TCP timers).
 225:LWIP/Target/ethernetif.c ****  */
 226:LWIP/Target/ethernetif.c **** 
 227:LWIP/Target/ethernetif.c **** static err_t low_level_output(struct netif *netif, struct pbuf *p)
 228:LWIP/Target/ethernetif.c **** {
 229:LWIP/Target/ethernetif.c ****   uint32_t i = 0U;
 230:LWIP/Target/ethernetif.c ****   struct pbuf *q = NULL;
 231:LWIP/Target/ethernetif.c ****   err_t errval = ERR_OK;
 232:LWIP/Target/ethernetif.c ****   ETH_BufferTypeDef Txbuffer[ETH_TX_DESC_CNT] = {0};
 233:LWIP/Target/ethernetif.c **** 
 234:LWIP/Target/ethernetif.c ****   memset(Txbuffer, 0 , ETH_TX_DESC_CNT*sizeof(ETH_BufferTypeDef));
 235:LWIP/Target/ethernetif.c **** 
 236:LWIP/Target/ethernetif.c ****   for(q = p; q != NULL; q = q->next)
 237:LWIP/Target/ethernetif.c ****   {
 238:LWIP/Target/ethernetif.c ****     if(i >= ETH_TX_DESC_CNT)
 239:LWIP/Target/ethernetif.c ****       return ERR_IF;
 240:LWIP/Target/ethernetif.c **** 
 241:LWIP/Target/ethernetif.c ****     Txbuffer[i].buffer = q->payload;
 242:LWIP/Target/ethernetif.c ****     Txbuffer[i].len = q->len;
 243:LWIP/Target/ethernetif.c **** 
 244:LWIP/Target/ethernetif.c ****     if(i>0)
 245:LWIP/Target/ethernetif.c ****     {
 246:LWIP/Target/ethernetif.c ****       Txbuffer[i-1].next = &Txbuffer[i];
 247:LWIP/Target/ethernetif.c ****     }
 248:LWIP/Target/ethernetif.c **** 
 249:LWIP/Target/ethernetif.c ****     if(q->next == NULL)
 250:LWIP/Target/ethernetif.c ****     {
 251:LWIP/Target/ethernetif.c ****       Txbuffer[i].next = NULL;
 252:LWIP/Target/ethernetif.c ****     }
 253:LWIP/Target/ethernetif.c **** 
 254:LWIP/Target/ethernetif.c ****     i++;
 255:LWIP/Target/ethernetif.c ****   }
 256:LWIP/Target/ethernetif.c **** 
 257:LWIP/Target/ethernetif.c ****   TxConfig.Length = p->tot_len;
 258:LWIP/Target/ethernetif.c ****   TxConfig.TxBuffer = Txbuffer;
ARM GAS  /tmp/cc3xlEco.s 			page 6


 259:LWIP/Target/ethernetif.c ****   TxConfig.pData = p;
 260:LWIP/Target/ethernetif.c **** 
 261:LWIP/Target/ethernetif.c ****   HAL_ETH_Transmit(&heth, &TxConfig, ETH_DMA_TRANSMIT_TIMEOUT);
 262:LWIP/Target/ethernetif.c **** 
 263:LWIP/Target/ethernetif.c ****   return errval;
 264:LWIP/Target/ethernetif.c **** }
