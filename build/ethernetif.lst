  56:LWIP/Target/ethernetif.c **** /*
  57:LWIP/Target/ethernetif.c **** @Note: This interface is implemented to operate in zero-copy mode only:
  58:LWIP/Target/ethernetif.c ****         - Rx Buffers will be allocated from LwIP stack Rx memory pool,
  59:LWIP/Target/ethernetif.c ****           then passed to ETH HAL driver.
  60:LWIP/Target/ethernetif.c ****         - Tx Buffers will be allocated from LwIP stack memory heap,
  61:LWIP/Target/ethernetif.c ****           then passed to ETH HAL driver.
  62:LWIP/Target/ethernetif.c **** 
  63:LWIP/Target/ethernetif.c **** @Notes:
  64:LWIP/Target/ethernetif.c ****   1.a. ETH DMA Rx descriptors must be contiguous, the default count is 4,
  65:LWIP/Target/ethernetif.c ****        to customize it please redefine ETH_RX_DESC_CNT in ETH GUI (Rx Descriptor Length)
  66:LWIP/Target/ethernetif.c ****        so that updated value will be generated in stm32xxxx_hal_conf.h
  67:LWIP/Target/ethernetif.c ****   1.b. ETH DMA Tx descriptors must be contiguous, the default count is 4,
  68:LWIP/Target/ethernetif.c ****        to customize it please redefine ETH_TX_DESC_CNT in ETH GUI (Tx Descriptor Length)
  69:LWIP/Target/ethernetif.c ****        so that updated value will be generated in stm32xxxx_hal_conf.h
  70:LWIP/Target/ethernetif.c **** 
  71:LWIP/Target/ethernetif.c ****   2.a. Rx Buffers number must be between ETH_RX_DESC_CNT and 2*ETH_RX_DESC_CNT
  72:LWIP/Target/ethernetif.c ****   2.b. Rx Buffers must have the same size: ETH_RX_BUF_SIZE, this value must
  73:LWIP/Target/ethernetif.c ****        passed to ETH DMA in the init field (heth.Init.RxBuffLen)
  74:LWIP/Target/ethernetif.c ****   2.c  The RX Ruffers addresses and sizes must be properly defined to be aligned
  75:LWIP/Target/ethernetif.c ****        to L1-CACHE line size (32 bytes).
  76:LWIP/Target/ethernetif.c **** */
  77:LWIP/Target/ethernetif.c **** 
  78:LWIP/Target/ethernetif.c **** /* Data Type Definitions */
  79:LWIP/Target/ethernetif.c **** typedef enum
  80:LWIP/Target/ethernetif.c **** {
  81:LWIP/Target/ethernetif.c ****   RX_ALLOC_OK       = 0x00,
  82:LWIP/Target/ethernetif.c ****   RX_ALLOC_ERROR    = 0x01
  83:LWIP/Target/ethernetif.c **** } RxAllocStatusTypeDef;
  84:LWIP/Target/ethernetif.c **** 
  85:LWIP/Target/ethernetif.c **** typedef struct
  86:LWIP/Target/ethernetif.c **** {
  87:LWIP/Target/ethernetif.c ****   struct pbuf_custom pbuf_custom;
ARM GAS  /tmp/ccuMBXbt.s 			page 3


  88:LWIP/Target/ethernetif.c ****   uint8_t buff[(ETH_RX_BUF_SIZE + 31) & ~31] __ALIGNED(32);
  89:LWIP/Target/ethernetif.c **** } RxBuff_t;
  90:LWIP/Target/ethernetif.c **** 
  91:LWIP/Target/ethernetif.c **** /* Memory Pool Declaration */
  92:LWIP/Target/ethernetif.c **** #define ETH_RX_BUFFER_CNT             12U
  93:LWIP/Target/ethernetif.c **** LWIP_MEMPOOL_DECLARE(RX_POOL, ETH_RX_BUFFER_CNT, sizeof(RxBuff_t), "Zero-copy RX PBUF pool");
  94:LWIP/Target/ethernetif.c **** 
