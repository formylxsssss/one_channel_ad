 333:LWIP/Target/ethernetif.c **** /**
 334:LWIP/Target/ethernetif.c ****  * @brief Should be called at the beginning of the program to set up the
 335:LWIP/Target/ethernetif.c ****  * network interface. It calls the function low_level_init() to do the
 336:LWIP/Target/ethernetif.c ****  * actual setup of the hardware.
 337:LWIP/Target/ethernetif.c ****  *
 338:LWIP/Target/ethernetif.c ****  * This function should be passed as a parameter to netif_add().
 339:LWIP/Target/ethernetif.c ****  *
 340:LWIP/Target/ethernetif.c ****  * @param netif the lwip network interface structure for this ethernetif
 341:LWIP/Target/ethernetif.c ****  * @return ERR_OK if the loopif is initialized
 342:LWIP/Target/ethernetif.c ****  *         ERR_MEM if private data couldn't be allocated
 343:LWIP/Target/ethernetif.c ****  *         any other err_t on error
 344:LWIP/Target/ethernetif.c ****  */
 345:LWIP/Target/ethernetif.c **** err_t ethernetif_init(struct netif *netif)
 346:LWIP/Target/ethernetif.c **** {
 347:LWIP/Target/ethernetif.c ****   LWIP_ASSERT("netif != NULL", (netif != NULL));
 348:LWIP/Target/ethernetif.c **** 
 349:LWIP/Target/ethernetif.c **** #if LWIP_NETIF_HOSTNAME
 350:LWIP/Target/ethernetif.c ****   /* Initialize interface hostname */
 351:LWIP/Target/ethernetif.c ****   netif->hostname = "lwip";
 352:LWIP/Target/ethernetif.c **** #endif /* LWIP_NETIF_HOSTNAME */
 353:LWIP/Target/ethernetif.c **** 
 354:LWIP/Target/ethernetif.c ****   /*
 355:LWIP/Target/ethernetif.c ****    * Initialize the snmp variables and counters inside the struct netif.
 356:LWIP/Target/ethernetif.c ****    * The last argument should be replaced with your link speed, in units
 357:LWIP/Target/ethernetif.c ****    * of bits per second.
 358:LWIP/Target/ethernetif.c ****    */
 359:LWIP/Target/ethernetif.c ****   // MIB2_INIT_NETIF(netif, snmp_ifType_ethernet_csmacd, LINK_SPEED_OF_YOUR_NETIF_IN_BPS);
 360:LWIP/Target/ethernetif.c **** 
 361:LWIP/Target/ethernetif.c ****   netif->name[0] = IFNAME0;
 362:LWIP/Target/ethernetif.c ****   netif->name[1] = IFNAME1;
 363:LWIP/Target/ethernetif.c ****   /* We directly use etharp_output() here to save a function call.
 364:LWIP/Target/ethernetif.c ****    * You can instead declare your own function an call etharp_output()
 365:LWIP/Target/ethernetif.c ****    * from it if you have to do some checks before sending (e.g. if link
 366:LWIP/Target/ethernetif.c ****    * is available...) */
 367:LWIP/Target/ethernetif.c **** 
 368:LWIP/Target/ethernetif.c **** #if LWIP_IPV4
 369:LWIP/Target/ethernetif.c **** #if LWIP_ARP || LWIP_ETHERNET
 370:LWIP/Target/ethernetif.c **** #if LWIP_ARP
 371:LWIP/Target/ethernetif.c ****   netif->output = etharp_output;
 372:LWIP/Target/ethernetif.c **** #else
 373:LWIP/Target/ethernetif.c ****   /* The user should write its own code in low_level_output_arp_off function */
 374:LWIP/Target/ethernetif.c ****   netif->output = low_level_output_arp_off;
 375:LWIP/Target/ethernetif.c **** #endif /* LWIP_ARP */
 376:LWIP/Target/ethernetif.c **** #endif /* LWIP_ARP || LWIP_ETHERNET */
 377:LWIP/Target/ethernetif.c **** #endif /* LWIP_IPV4 */
 378:LWIP/Target/ethernetif.c **** 
 379:LWIP/Target/ethernetif.c **** #if LWIP_IPV6
ARM GAS  /tmp/cc3xlEco.s 			page 17


 380:LWIP/Target/ethernetif.c ****   netif->output_ip6 = ethip6_output;
 381:LWIP/Target/ethernetif.c **** #endif /* LWIP_IPV6 */
 382:LWIP/Target/ethernetif.c **** 
 383:LWIP/Target/ethernetif.c ****   netif->linkoutput = low_level_output;
 384:LWIP/Target/ethernetif.c **** 
 385:LWIP/Target/ethernetif.c ****   /* initialize the hardware */
 386:LWIP/Target/ethernetif.c ****   low_level_init(netif);
 387:LWIP/Target/ethernetif.c **** 
 388:LWIP/Target/ethernetif.c ****   return ERR_OK;
 389:LWIP/Target/ethernetif.c **** }
