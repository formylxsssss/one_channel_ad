 286:LWIP/Target/ethernetif.c **** /**
 287:LWIP/Target/ethernetif.c ****  * @brief This function should be called when a packet is ready to be read
 288:LWIP/Target/ethernetif.c ****  * from the interface. It uses the function low_level_input() that
 289:LWIP/Target/ethernetif.c ****  * should handle the actual reception of bytes from the network
 290:LWIP/Target/ethernetif.c ****  * interface. Then the type of the received packet is determined and
 291:LWIP/Target/ethernetif.c ****  * the appropriate input function is called.
 292:LWIP/Target/ethernetif.c ****  *
 293:LWIP/Target/ethernetif.c ****  * @param netif the lwip network interface structure for this ethernetif
 294:LWIP/Target/ethernetif.c ****  */
 295:LWIP/Target/ethernetif.c **** void ethernetif_input(struct netif *netif)
 296:LWIP/Target/ethernetif.c **** {
 297:LWIP/Target/ethernetif.c ****   struct pbuf *p = NULL;
 298:LWIP/Target/ethernetif.c **** 
 299:LWIP/Target/ethernetif.c ****   do
 300:LWIP/Target/ethernetif.c ****   {
 301:LWIP/Target/ethernetif.c ****     p = low_level_input( netif );
 302:LWIP/Target/ethernetif.c ****     if (p != NULL)
 303:LWIP/Target/ethernetif.c ****     {
 304:LWIP/Target/ethernetif.c ****       if (netif->input( p, netif) != ERR_OK )
 305:LWIP/Target/ethernetif.c ****       {
 306:LWIP/Target/ethernetif.c ****         pbuf_free(p);
 307:LWIP/Target/ethernetif.c ****       }
 308:LWIP/Target/ethernetif.c ****     }
 309:LWIP/Target/ethernetif.c ****   } while(p!=NULL);
 310:LWIP/Target/ethernetif.c **** }
 311:LWIP/Target/ethernetif.c **** 
